generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model ApiKey {
    id        String    @id @default(cuid())

    createdAt DateTime  @default(now())
    hash      String // sha256 of full key
    label     String
    lastUsed  DateTime?
    prefix    String // shown to user
    sentCount Int       @default(0)
    userId    String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([prefix])
    @@index([userId])
}

model Attachment {
    id         String   @id @default(cuid())
    messageId  String
    filename   String
    mimeType   String
    size       Int
    storageKey String
    expiresAt  DateTime
    createdAt  DateTime @default(now())

    message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

    @@index([messageId])
    @@index([expiresAt])
}

model Acknowledgment {
    id        String   @id @default(cuid())
    messageId String
    deviceId  String
    userId    String?
    createdAt DateTime @default(now())

    message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user    User?   @relation(fields: [userId], references: [id])

    @@unique([messageId, deviceId])
    @@index([messageId])
}

model Message {
    id        String   @id @default(cuid())
   
    actions     String   @default("[]") // JSON array of Action objects
    body        String
    createdAt   DateTime @default(now())
    deliveredAt DateTime?
    priority    Int      @default(3) // 1=min..5=max
    scheduledAt DateTime?
    senderId    String?
    tags        String // JSON array string for sqlite
    title       String
    topicId     String

    acknowledgments Acknowledgment[]
    attachments     Attachment[]
    sender          User?              @relation("MessageSender", fields: [senderId], references: [id])
    topic           Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)

    @@index([topicId, createdAt])
    @@index([topicId])
    @@index([scheduledAt])
}

model PushToken {
    id        String   @id @default(cuid())

    createdAt   DateTime @default(now())
    deviceId    String
    platform    String // "ios" | "android" | "web"
    pushEnabled Boolean  @default(true)
    token       String
    updatedAt   DateTime @updatedAt
    userId      String?

    user User? @relation(fields: [userId], references: [id])

    @@index([token])
    @@index([userId])
    @@unique([deviceId, token])
}

model Session {
    id        String   @id @default(cuid())

    createdAt DateTime @default(now())
    expiresAt DateTime
    token     String   @unique
    userId    String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}


model Subscription {
    id          String   @id @default(cuid())

    createdAt   DateTime @default(now())
    deviceId    String
    pushEnabled Boolean  @default(true)
    topicId     String
    userId      String?

    topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
    user  User? @relation(fields: [userId], references: [id])

    @@index([topicId])
    @@index([userId])
    @@unique([deviceId, topicId])
}

model Topic {
    id          String   @id @default(cuid())

    createdAt   DateTime @default(now())
    description String?
    displayName String
    isPublic    Boolean  @default(true)
    name        String   @unique
    updatedAt   DateTime @updatedAt

    owner   User?   @relation("TopicOwner", fields: [ownerId], references: [id])
    ownerId String?

    access        TopicAccess[]
    messages      Message[]
    subscriptions Subscription[]

    @@index([isPublic])
    @@index([ownerId])
}

model TopicAccess {
    id        String   @id @default(cuid())

    grantedAt DateTime @default(now())
    role      String // "owner" | "publisher" | "subscriber"
    topicId   String
    userId    String

    topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([topicId])
    @@index([userId])
    @@unique([topicId, userId])
}

model User {
    id        String   @id @default(cuid())

    createdAt DateTime @default(now())
    email     String   @unique
    name      String?
    updatedAt DateTime @updatedAt

    acknowledgments   Acknowledgment[]
    apiKeys           ApiKey[]
    ownedTopics       Topic[]         @relation("TopicOwner")
    pushTokens        PushToken[]
    sentMessages      Message[]       @relation("MessageSender")
    sessions          Session[]
    subscriptions     Subscription[]
    topicAccess       TopicAccess[]
    verificationCodes VerificationCode[]
}

model VerificationCode {
    id        String   @id @default(cuid())

    code      String
    consumed  Boolean  @default(false)
    createdAt DateTime @default(now())
    email     String
    expiresAt DateTime

    user   User?   @relation(fields: [userId], references: [id])
    userId String?

    @@index([code])
    @@index([email])
}