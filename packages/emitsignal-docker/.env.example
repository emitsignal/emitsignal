# ── Auth ──────────────────────────────────────────────────────────────────────
# Required. Generate a strong random secret:
#   openssl rand -hex 32
JWT_SECRET=

# ── Database (production) ─────────────────────────────────────────────────────
# Required for production compose. Used as POSTGRES_PASSWORD and in DATABASE_URL.
POSTGRES_PASSWORD=

# ── Ports (optional — defaults shown) ────────────────────────────────────────
SERVER_PORT=5100
WEBSITE_PORT=5000

EMAIL_PROVIDER=log
EMAIL_FROM=EmitSignal <noreply@emitsignal.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=

# FILE_STORAGE_PROVIDER options: local | s3
FILE_STORAGE_PROVIDER=local

# S3 settings (required when FILE_STORAGE_PROVIDER=s3)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=
