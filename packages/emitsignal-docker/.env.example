# ── Auth ──────────────────────────────────────────────────────────────────────
# Required. This is the Better Auth signing secret for sessions/tokens. The
# server REFUSES TO BOOT in production if this is unset or left at the dev
# default. Generate a strong random value:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Database (production) ─────────────────────────────────────────────────────
# Required for production compose. Used as POSTGRES_PASSWORD and in DATABASE_URL.
POSTGRES_PASSWORD=

# Required for production compose. Password for Redis (BullMQ jobs, rate limits,
# quotas). Generate a strong random value: openssl rand -base64 32
REDIS_PASSWORD=

# ── Domains (Traefik / Dokploy) ───────────────────────────────────────────────
# Domain for the API server — used in Traefik routing and APP_URL.
API_DOMAIN=api.yourdomain.com
# Domain for the website.
APP_DOMAIN=yourdomain.com
# Full HTTPS URL of the API — used as the server's auth baseURL and the website build (VITE_API_URL).
API_URL=https://api.yourdomain.com
# Full HTTPS URL of the website — used by the server for the passkey origin and to
# derive the auth cookie domain (the shared parent of the website + API subdomain).
APP_URL=https://yourdomain.com

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Which request header carries the real client IP. Rate limiting keys on it, so
# getting this wrong is not cosmetic:
#   none             — trust nothing; use the TCP peer address (safe default,
#                      correct only when the server is exposed directly)
#   cf-connecting-ip — behind Cloudflare
#   x-real-ip        — behind Nginx with `proxy_set_header X-Real-IP $remote_addr`
#   x-forwarded-for  — behind Traefik/ALB; the rightmost public hop is used
#
# Leave as `none` and every request behind a proxy shares one rate-limit bucket
# keyed on the proxy's IP — anonymous publish/upload/SSE will 429 platform-wide.
# Set this to whatever your proxy actually sets, and make sure the proxy
# overwrites (not appends to) that header on inbound requests.
TRUSTED_PROXY_HEADER=none

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=log
EMAIL_FROM=EmitSignal <noreply@emitsignal.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Set OTEL_ENABLED=true to activate distributed tracing.
# OTEL_EXPORTER_ENDPOINT: your OTLP ingesting host (e.g. from BetterStack, Grafana, etc.)
# OTEL_EXPORTER_AUTH_TOKEN: Bearer token for the OTLP endpoint.

OTEL_ENABLED=false
OTEL_EXPORTER_AUTH_TOKEN=
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=emitsignal-server
OTEL_TRACES_SAMPLE_RATE=1
OTEL_WORKER_SERVICE_NAME=emitsignal-worker

# ── File storage ──────────────────────────────────────────────────────────────
# FILE_STORAGE_PROVIDER options: local | s3
FILE_STORAGE_PROVIDER=local

# S3 settings (required when FILE_STORAGE_PROVIDER=s3)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket for message attachments (presigned URLs)
S3_PRIVATE_BUCKET_NAME=
# Public-read bucket for avatars; falls back to the private bucket if unset
S3_PUBLIC_BUCKET_NAME=
# Public/CDN base URL for the public bucket, e.g. https://cdn.example.com
S3_PUBLIC_URL_BASE=
S3_ENDPOINT=
S3_REGION=
