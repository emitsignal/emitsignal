# API base URL
EXPO_PUBLIC_API_URL=http://127.0.0.1:5001
EXPO_PUBLIC_PUBLISH_BASE_URL=

# Public website, used to build shareable message links (/s/:shareId)
EXPO_PUBLIC_WEB_URL=https://emitsignal.com

# Sentry error tracking (optional)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENABLED=false

SENTRY_DISABLE_AUTO_UPLOAD=true
