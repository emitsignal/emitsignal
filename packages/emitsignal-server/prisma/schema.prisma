generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// ── Better Auth core tables ──────────────────────────────────────────────────

model User {
    id            String   @id @default(cuid())
    name          String?
    email         String   @unique
    emailVerified Boolean  @default(false)
    image         String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    accounts      Account[]
    apiKeys       ApiKey[]
    passkeys      Passkey[]
    sessions      Session[]

    // App-specific relations
    acknowledgments   Acknowledgment[]
    ownedTopics       Topic[]         @relation("TopicOwner")
    pushTokens        PushToken[]
    sentMessages      Message[]       @relation("MessageSender")
    subscriptions     Subscription[]
    topicAccess       TopicAccess[]
    webhooks          Webhook[]
}

model Session {
    id        String   @id @default(cuid())
    expiresAt DateTime
    token     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Account {
    id                    String    @id @default(cuid())
    accountId             String
    providerId            String
    userId                String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@unique([providerId, accountId])
}

model Verification {
    id         String   @id @default(cuid())
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
}

// ── Better Auth plugin tables ─────────────────────────────────────────────────

model ApiKey {
    id                  String    @id @default(cuid())
    name                String?
    start               String?
    prefix              String?
    key                 String    @unique
    userId              String?
    refillInterval      Int?
    refillAmount        Int?
    lastRefillAt        DateTime?
    enabled             Boolean   @default(true)
    rateLimitEnabled    Boolean   @default(false)
    rateLimitTimeWindow Int?
    rateLimitMax        Int?
    requestCount        Int       @default(0)
    remaining           Int?
    lastRequest         DateTime?
    expiresAt           DateTime?
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt
    permissions         String?
    metadata            String?

    user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([key])
}

model Passkey {
    id           String    @id @default(cuid())
    name         String?
    publicKey    String
    userId       String
    credentialID String
    counter      Int
    deviceType   String
    backedUp     Boolean
    transports   String?
    createdAt    DateTime? @default(now())
    aaguid       String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// ── App tables ────────────────────────────────────────────────────────────────

model Attachment {
    id         String   @id @default(cuid())
    messageId  String
    filename   String
    mimeType   String
    size       Int
    storageKey String
    expiresAt  DateTime
    createdAt  DateTime @default(now())

    message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

    @@index([messageId])
    @@index([expiresAt])
}

model Acknowledgment {
    id        String   @id @default(cuid())
    messageId String
    deviceId  String
    userId    String?
    createdAt DateTime @default(now())

    message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user    User?   @relation(fields: [userId], references: [id])

    @@unique([messageId, deviceId])
    @@index([messageId])
}

model Message {
    id        String   @id @default(cuid())

    actions     String   @default("[]") // JSON array of Action objects
    body        String
    createdAt   DateTime @default(now())
    deliveredAt DateTime?
    priority    Int      @default(3) // 1=min..5=max
    scheduledAt DateTime?
    senderId    String?
    tags        String // JSON array string for sqlite
    title       String
    topicId     String

    acknowledgments Acknowledgment[]
    attachments     Attachment[]
    sender          User?              @relation("MessageSender", fields: [senderId], references: [id])
    topic           Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)

    @@index([topicId, createdAt])
    @@index([topicId])
    @@index([scheduledAt])
}

model PushToken {
    id        String   @id @default(cuid())

    createdAt   DateTime @default(now())
    deviceId    String
    platform    String // "ios" | "android" | "web"
    pushEnabled Boolean  @default(true)
    token       String
    updatedAt   DateTime @updatedAt
    userId      String?

    user User? @relation(fields: [userId], references: [id])

    @@index([token])
    @@index([userId])
    @@unique([deviceId, token])
}

model Subscription {
    id          String   @id @default(cuid())

    createdAt   DateTime @default(now())
    deviceId    String
    pushEnabled Boolean  @default(true)
    topicId     String
    userId      String?

    topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
    user  User? @relation(fields: [userId], references: [id])

    @@index([topicId])
    @@index([userId])
    @@unique([deviceId, topicId])
}

model Topic {
    id          String   @id @default(cuid())

    createdAt   DateTime @default(now())
    description String?
    displayName String
    isPublic    Boolean  @default(true)
    name        String   @unique
    updatedAt   DateTime @updatedAt

    owner   User?   @relation("TopicOwner", fields: [ownerId], references: [id])
    ownerId String?

    access        TopicAccess[]
    messages      Message[]
    subscriptions Subscription[]

    @@index([isPublic])
    @@index([ownerId])
}

model TopicAccess {
    id        String   @id @default(cuid())

    grantedAt DateTime @default(now())
    role      String // "owner" | "publisher" | "subscriber"
    topicId   String
    userId    String

    topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([topicId])
    @@index([userId])
    @@unique([topicId, userId])
}

model Webhook {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name      String
    slug      String   @unique
    source    String   @default("custom")
    status    String   @default("active")
    template  String?
    topicName String
    userId    String

    deliveries WebhookDelivery[]
    user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([slug])
    @@index([userId])
}

model WebhookDelivery {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())

    messageId   String?
    ms          Int
    payload     String
    status      Int
    templated   Boolean
    webhookId   String

    webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

    @@index([webhookId, createdAt])
}
