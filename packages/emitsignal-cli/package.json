{
    "bin": {
        "emitsignal": "./dist/index.js",
        "es": "./dist/index.js"
    },
    "bugs": {
        "url": "https://github.com/emitsignal/emitsignal/issues"
    },
    "description": "EmitSignal CLI — publish and stream signals from your terminal",
    "devDependencies": {
        "@emitsignal/shared": "workspace:*",
        "@types/react": "^19.0.0",
        "commander": "^13.0.0",
        "ink": "^7.1.0",
        "react": "^19.0.0",
        "smol-toml": "^1.3.1"
    },
    "files": ["dist", "LICENSE"],
    "homepage": "https://emitsignal.com/cli",
    "license": "AGPL-3.0-only",
    "name": "@emitsignal/cli",
    "private": false,
    "repository": {
        "directory": "packages/emitsignal-cli",
        "type": "git",
        "url": "https://github.com/emitsignal/emitsignal.git"
    },
    "scripts": {
        "build": "bun build --target node --format esm --minify src/index.ts --outdir dist",
        "build:binaries": "bun run scripts/build-binaries.ts",
        "dev": "bun run src/index.ts",
        "prepublishOnly": "bun run build",
        "render:formula": "bun run scripts/render-formula.ts",
        "type-check": "tsc --noEmit",
        "watch-dist": "bun run scripts/watch-dist.ts"
    },
    "type": "module",
    "version": "1.4.0"
}
