# Apple Sign In (optional — the first 4 are required to enable)
# APPLE_CLIENT_ID   = the Service ID identifier, e.g. com.emitsignal.web
# APPLE_TEAM_ID     = your 10-char Apple Developer Team ID
# APPLE_KEY_ID      = the Key ID of the "Sign In with Apple" .p8 key
# APPLE_PRIVATE_KEY = full contents of the downloaded .p8 file (PKCS#8, keep the
#                     -----BEGIN/END PRIVATE KEY----- lines; use \n or quotes for newlines)
# APPLE_APP_BUNDLE_IDENTIFIER = native iOS App ID; only needed for mobile ID-token sign-in
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=

# App base URL (used by Better Auth for CORS and magic-link callbacks)
APP_URL=http://localhost:5002
API_URL=http://localhost:5001

# Server environment variables
DATABASE_URL=postgresql://emitsignal:emitsignal@localhost:5432/emitsignal

# Email delivery
EMAIL_PROVIDER=log            # "log" | "smtp" | "resend"
EMAIL_FROM=EmitSignal <noreply@emitsignal.com>

# Resend (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=


# Better Auth
BETTER_AUTH_SECRET=

# Restrict email OTP sign-in to a comma-separated allowlist.
# Empty = allowlist disabled (anyone may sign in).
AUTH_ALLOWED_EMAILS=

# GitHub OAuth (optional — omit to disable GitHub sign-in)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# SMTP (when EMAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Stripe billing (optional — omit to disable paid plans; all 6 are required to enable)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PULSE_MONTHLY=
STRIPE_PRICE_PULSE_YEARLY=
STRIPE_PRICE_BEAM_MONTHLY=
STRIPE_PRICE_BEAM_YEARLY=

# BullMQ / Redis
REDIS_URL=redis://localhost:6379

# Better Stack / Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_ENABLED=false

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=emitsignal-server
OTEL_TRACES_SAMPLE_RATE=1
OTEL_WORKER_SERVICE_NAME=emitsignal-worker