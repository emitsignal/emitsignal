{
    "$schema": "https://mintlify.com/schema.json",
    "colors": {
        "anchors": {
            "from": "#a78bfa",
            "to": "#7c3aed"
        },
        "background": {
            "dark": "#0f0a1a",
            "light": "#ffffff"
        },
        "dark": "#7c3aed",
        "light": "#c4b5fd",
        "primary": "#a78bfa"
    },
    "favicon": "/favicon.svg",
    "font": {
        "body": {
            "family": "Geist"
        },
        "headings": {
            "family": "Geist"
        }
    },
    "footerSocials": {
        "github": "https://github.com/kevenleone/emitsignal"
    },
    "logo": {
        "dark": "/logo/dark.svg",
        "href": "/cli/index",
        "light": "/logo/dark.svg"
    },
    "modeToggle": {
        "default": "dark"
    },
    "name": "EmitSignal",
    "navigation": [
        {
            "group": "Overview",
            "pages": ["cli/index"]
        },
        {
            "group": "Getting started",
            "pages": ["cli/install", "cli/auth", "cli/quickstart"]
        },
        {
            "group": "Commands",
            "pages": [
                "cli/publish",
                "cli/listen",
                "cli/subscribe",
                "cli/keys",
                "cli/config",
                "cli/tui"
            ]
        },
        {
            "group": "Concepts",
            "pages": ["cli/filters", "cli/formats", "cli/exits"]
        },
        {
            "group": "Beyond the CLI",
            "pages": ["cli/sdk"]
        }
    ],
    "tabs": [
        {
            "name": "CLI Reference",
            "url": "cli"
        }
    ],
    "topbarCtaButton": {
        "name": "Get started",
        "url": "https://emitsignal.com"
    },
    "topbarLinks": [
        {
            "name": "GitHub",
