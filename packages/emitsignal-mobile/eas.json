{
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "APP_MODE": "development",
                "EXPO_PUBLIC_SENTRY_ENABLED": "false",
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            }
        },
        "ios-simulator": {
            "extends": "development",
            "ios": {
                "simulator": true
            }
        },
        "preview": {
            "channel": "preview",
            "distribution": "internal",
            "env": {
                "APP_MODE": "preview",
                "EXPO_PUBLIC_SENTRY_ENABLED": "false",
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            }
        },
        "production": {
            "autoIncrement": true,
            "channel": "production",
            "env": {
                "APP_MODE": "production",
                "SENTRY_DISABLE_XCODE_DEBUG_UPLOAD": "true"
            }
        }
    },
    "cli": {
        "appVersionSource": "remote",
        "version": ">= 18.13.0"
    },
    "submit": {
        "production": {}
    }
}
