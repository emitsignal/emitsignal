generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}


// ── Better Auth plugin tables ─────────────────────────────────────────────────
model Apikey {
    id                  String    @id @default(cuid())
   
    configId            String?
    createdAt           DateTime  @default(now())
    enabled             Boolean   @default(true)
    expiresAt           DateTime?
    key                 String    @unique
    lastRefillAt        DateTime?
    lastRequest         DateTime?
    metadata            String?
    name                String?
    permissions         String?
    prefix              String?
    rateLimitEnabled    Boolean   @default(false)
    rateLimitMax        Int?
    rateLimitTimeWindow Int?
    referenceId         String?
    refillAmount        Int?
    refillInterval      Int?
    remaining           Int?
    requestCount        Int       @default(0)
    start               String?
    updatedAt           DateTime  @updatedAt
    userId              String?

    user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("ApiKey")
    @@index([userId])
    @@index([key])
}

model Passkey {
    id           String    @id @default(cuid())

    aaguid       String?
    backedUp     Boolean
    counter      Int
    createdAt    DateTime? @default(now())
    credentialID String
    deviceType   String
    name         String?
    publicKey    String
    transports   String?
    userId       String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// ── Better Auth core tables ──────────────────────────────────────────────────
model Account {
    id                    String    @id @default(cuid())

    accessToken           String?
    accessTokenExpiresAt  DateTime?
    accountId             String
    createdAt             DateTime  @default(now())
    idToken               String?
    password              String?
    providerId            String
    refreshToken          String?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    updatedAt             DateTime  @updatedAt
    userId                String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@unique([providerId, accountId])
}

model Session {
    id        String   @id @default(cuid())
    
    createdAt DateTime @default(now())
    expiresAt DateTime
    token     String   @unique
    updatedAt DateTime @updatedAt
    userAgent String?
    userId    String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model User {
    id            String   @id @default(cuid())

    createdAt        DateTime @default(now())
    email            String   @unique
    emailVerified    Boolean  @default(false)
    image            String?
    name             String?
    onboarded        Boolean  @default(false)
    stripeCustomerId String?
    updatedAt        DateTime @updatedAt

    accounts      Account[]
    apiKeys       Apikey[]
    passkeys      Passkey[]
    sessions      Session[]

    // App-specific relations
    acknowledgments   Acknowledgment[]
    ownedTopics       Topic[]         @relation("TopicOwner")
    pushTokens        PushToken[]
    sentMessages      Message[]       @relation("MessageSender")
    subscriptions     Subscription[]
    topicAccess       TopicAccess[]
    webhooks          Webhook[]
}

// Stripe billing subscriptions (managed by the @better-auth/stripe plugin).
// Named PlanSubscription because Subscription already means topic subscriptions.
model PlanSubscription {
    id                   String    @id @default(cuid())

    billingInterval      String?
    cancelAt             DateTime?
    cancelAtPeriodEnd    Boolean?  @default(false)
    canceledAt           DateTime?
    createdAt            DateTime  @default(now())
    endedAt              DateTime?
    periodEnd            DateTime?
    periodStart          DateTime?
    plan                 String
    referenceId          String
    seats                Int?
    status               String    @default("incomplete")
    stripeCustomerId     String?
    stripeScheduleId     String?
    stripeSubscriptionId String?
    trialEnd             DateTime?
    trialStart           DateTime?
    updatedAt            DateTime  @updatedAt

    @@index([referenceId])
    @@index([stripeCustomerId])
}

model Verification {
    id         String   @id @default(cuid())

    createdAt  DateTime @default(now())
    expiresAt  DateTime
    identifier String
    updatedAt  DateTime @updatedAt
    value      String

    @@index([identifier])
}


// ── App tables ────────────────────────────────────────────────────────────────
model Attachment {
    id         String   @id @default(cuid())

    createdAt  DateTime @default(now())
    expiresAt  DateTime
    filename   String
    messageId  String
    mimeType   String
    size       Int
    storageKey String

    message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

    @@index([messageId])
    @@index([expiresAt])
}

model Acknowledgment {
    id        String   @id @default(cuid())

    createdAt DateTime @default(now())
    deviceId  String
    messageId String
    userId    String?

    message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user    User?   @relation(fields: [userId], references: [id])

    @@unique([messageId, deviceId])
    @@index([messageId])
    @@index([userId])
}

model Message {
    id        String   @id @default(cuid())

    actions           String   @default("[]") // JSON array of Action objects
    bannerImage       String? // JSON {title?, href} or null
    body              String
    createdAt         DateTime @default(now())
    deliveredAt       DateTime?
    inlineAttachments String   @default("[]") // JSON array of {title?, href}
    inlineImages      String   @default("[]") // JSON array of {title?, href}
    priority          Int      @default(3) // 1=min..5=max
    scheduledAt       DateTime?
    senderId          String?
    tags              String // JSON array string for sqlite
    title             String
    topicId           String

    acknowledgments Acknowledgment[]
    attachments     Attachment[]
    sender          User?              @relation("MessageSender", fields: [senderId], references: [id])
    topic           Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)

    @@index([topicId, createdAt])
    @@index([topicId])
    @@index([scheduledAt])
    @@index([senderId])
}

model PushToken {
    id        String   @id @default(cuid())

    createdAt   DateTime @default(now())
    deviceId    String
    platform    String // "ios" | "android" | "web"
    pushEnabled Boolean  @default(true)
    token       String
    updatedAt   DateTime @updatedAt
    userId      String?

    user User? @relation(fields: [userId], references: [id])

    @@index([token])
    @@index([userId])
    @@unique([deviceId, token])
}

model Subscription {
    id          String   @id @default(cuid())

    createdAt   DateTime @default(now())
    deviceId    String
    pushEnabled Boolean  @default(true)
    settings    String   @default("{}")
    topicId     String
    userId      String?

    topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
    user  User? @relation(fields: [userId], references: [id])

    @@index([topicId])
    @@index([userId])
    @@unique([deviceId, topicId])
}

model Topic {
    id          String   @id @default(cuid())

    createdAt   DateTime @default(now())
    description String?
    displayName String
    isPublic    Boolean  @default(true)
    name        String   @unique
    updatedAt   DateTime @updatedAt

    owner   User?   @relation("TopicOwner", fields: [ownerId], references: [id])
    ownerId String?

    access        TopicAccess[]
    messages      Message[]
    subscriptions Subscription[]

    @@index([isPublic])
    @@index([ownerId])
}

model TopicAccess {
    id        String   @id @default(cuid())

    grantedAt DateTime @default(now())
    role      String // "owner" | "publisher" | "subscriber"
    topicId   String
    userId    String

    topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([topicId])
    @@index([userId])
    @@unique([topicId, userId])
}

model Webhook {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name      String
    slug      String   @unique
    source    String   @default("custom")
    status    String   @default("active")
    template  String?
    topicName String
    userId    String

    deliveries WebhookDelivery[]
    user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([slug])
    @@index([userId])
}

model WebhookDelivery {
    id        String   @id @default(cuid())

    createdAt DateTime @default(now())
    messageId   String?
    ms          Int
    payload     String
    status      Int
    templated   Boolean
    webhookId   String

    webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

    @@index([webhookId, createdAt])
}
