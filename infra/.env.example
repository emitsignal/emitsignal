# Infra backup/restore configuration.
#
# Copy to infra/.env and fill in your Cloudflare R2 credentials:
#   cp infra/.env.example infra/.env
#
# DATABASE_URL and the S3_* credentials are also read from
# packages/emitsignal-server/.env if not set here — so in dev you usually only
# need to add the R2 credentials and a bucket below.

# Database to dump/restore. Local dev value shown; point this at production to
# back up production. localhost is auto-routed to host.docker.internal.
DATABASE_URL="postgresql://emitsignal:emitsignal@localhost:5432/emitsignal"

# Cloudflare R2 (S3-compatible) credentials — same names the server uses.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2 ignores region; "auto" is the convention.
S3_REGION="auto"

# Bucket that holds the dumps. Falls back to S3_PRIVATE_BUCKET_NAME.
BACKUP_BUCKET="emitsignal-infra"
# Key prefix (folder) within the bucket.
BACKUP_PREFIX="db-backups"

# Docker image used to run pg_dump/pg_restore — keep in sync with the DB version.
POSTGRES_IMAGE="postgres:16-alpine"
