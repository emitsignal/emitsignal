# ── Auth ──────────────────────────────────────────────────────────────────────
# Required. Generate a strong random secret:
#   openssl rand -hex 32
JWT_SECRET=

# ── Database (production) ─────────────────────────────────────────────────────
# Required for production compose. Used as POSTGRES_PASSWORD and in DATABASE_URL.
POSTGRES_PASSWORD=

# ── Domains (Traefik / Dokploy) ───────────────────────────────────────────────
# Domain for the API server — used in Traefik routing and APP_URL.
API_DOMAIN=api.yourdomain.com
# Domain for the website.
APP_DOMAIN=yourdomain.com
# Full HTTPS URL of the API — used by the server (APP_URL) and website build (VITE_API_URL).
API_URL=https://api.yourdomain.com

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=log
EMAIL_FROM=EmitSignal <noreply@emitsignal.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Set OTEL_ENABLED=true to activate distributed tracing.
# OTEL_EXPORTER_ENDPOINT: your OTLP ingesting host (e.g. from BetterStack, Grafana, etc.)
# OTEL_EXPORTER_AUTH_TOKEN: Bearer token for the OTLP endpoint.

OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
OTEL_EXPORTER_AUTH_TOKEN=
OTEL_SERVICE_NAME=emitsignal-server
OTEL_WORKER_SERVICE_NAME=emitsignal-worker

# ── File storage ──────────────────────────────────────────────────────────────
# FILE_STORAGE_PROVIDER options: local | s3
FILE_STORAGE_PROVIDER=local

# S3 settings (required when FILE_STORAGE_PROVIDER=s3)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=
